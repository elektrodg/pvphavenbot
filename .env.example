# --- PvPHaven Bot config: copy to .env and fill in ---
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
# Optional: set to your test guild ID for instant slash-command sync. Leave empty for global sync (takes ~1h).
GUILD_ID=
# Command prefix for legacy prefix commands (most commands are slash commands)
PREFIX=!

# --- Tickets ---
TICKET_CATEGORY_ID=
TICKET_STAFF_ROLE_ID=
TICKET_LOG_CHANNEL_ID=
TICKET_PANEL_TITLE=PvPHaven Support
# Comma-separated panel buttons: name:label:emoji  (keep to max 4-5)
# Example: support:Support:🎫,report:Report Player:🚨,appeal:Ban Appeal:⚖️,other:Other:📦
TICKET_PANEL_OPTIONS=support:Support:🎫,report:Report Player:🚨,appeal:Ban Appeal:⚖️,other:Other:📦

# --- Website linking ---
# Public URL of your website, shown in /link instructions
WEBSITE_URL=https://pvphaven.example.com
# Shared secret: website -> bot API auth. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
LINK_API_KEY=CHANGE_ME_TO_LONG_RANDOM_STRING
# Port for the built-in link verification API (aiohttp). Your website calls http://host:PORT/verify
LINK_API_PORT=8090
LINK_API_HOST=0.0.0.0
# Link codes expire after N minutes
LINK_CODE_TTL_MINUTES=10

# --- Optional cosmetics ---
WELCOME_CHANNEL_ID=
AUTOROLE_ID=
LOG_CHANNEL_ID=
BOT_ACTIVITY=PvPHaven | /help
